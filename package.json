{
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "test": "./scripts/test.sh",
    "build": "./scripts/build.sh",
    "build:runtime": "./scripts/build.sh",
    "build:cpu": "./scripts/build.sh --cpu",
    "build:vd-gigaam": "cargo build -p vd-gigaam --release --features metal",
    "build:vd-gigaam:cpu": "cargo build -p vd-gigaam --release",
    "build:vd-fix-casing": "cargo build -p vd-fix-casing --release",
    "build:vd-fix-asr": "cargo build -p vd-fix-asr --release",
    "build:vd-fix-terms": "cargo build -p vd-fix-terms --release",
    "build:vd-assets": "cargo build -p vd-assets --release",
    "build:vd-diarize": "cargo build -p vd-diarize --release",
    "build:vd-meeting": "cargo build -p vd-meeting --release",
    "build:vd-preprocess": "cargo build -p vd-preprocess --release",
    "build:vd-postprocess": "cargo build -p vd-postprocess --release",
    "build:vd-pipeline": "cargo build -p vd-pipeline --release",
    "build:vd-srv": "cargo build -p vd-srv --release",
    "install:vd-gigaam": "cargo install --path src/cli/transcribe/vd-gigaam --locked --force --features metal",
    "install:vd-gigaam:cpu": "cargo install --path src/cli/transcribe/vd-gigaam --locked --force",
    "install:vd-fix-casing": "cargo install --path src/cli/fix/vd-fix-casing --locked --force",
    "install:vd-fix-asr": "cargo install --path src/cli/fix/vd-fix-asr --locked --force",
    "install:vd-fix-terms": "cargo install --path src/cli/fix/vd-fix-terms --locked --force",
    "install:vd-assets": "cargo install --path src/cli/process/vd-assets --locked --force",
    "install:vd-diarize": "cargo install --path src/cli/process/vd-diarize --locked --force",
    "install:vd-meeting": "cargo install --path src/cli/process/vd-meeting --locked --force",
    "install:vd-preprocess": "cargo install --path src/cli/process/vd-preprocess --locked --force",
    "install:vd-postprocess": "cargo install --path src/cli/process/vd-postprocess --locked --force",
    "install:vd-pipeline": "cargo install --path src/cli/process/vd-pipeline --locked --force",
    "install:vd-srv": "cargo install --path src/cli/manage/vd-srv --locked --force",
    "lint:rust": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "lefthook": "^1.11.13"
  }
}
